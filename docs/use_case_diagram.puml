@startuml
' Диаграмма вариантов использования для АИС магазина кастомных ПК
skinparam monochrome true
skinparam defaultFontName Arial
skinparam fontSize 12
skinparam actorStyle awesome

left to right direction

' ============================================
' Актеры
' ============================================
actor "Администратор" as Admin
actor "Менеджер" as Manager
actor "Сборщик" as Assembler
actor "Клиент" as Customer

package "АИС Магазин кастомных ПК" {
    
    ' ============================================
    ' Варианты использования - Авторизация
    ' ============================================
    usecase "Войти в систему" as UC_Login
    usecase "Выйти из системы" as UC_Logout
    usecase "Восстановить пароль" as UC_RecoverPassword
    
    ' ============================================
    ' Варианты использования - Управление пользователями (Администратор)
    ' ============================================
    usecase "Управлять пользователями" as UC_ManageUsers
    usecase "Назначать роли" as UC_AssignRoles
    usecase "Блокировать пользователя" as UC_BlockUser
    
    ' ============================================
    ' Варианты использования - Управление клиентами (Менеджер)
    ' ============================================
    usecase "Регистрировать клиента" as UC_RegisterClient
    usecase "Просматривать клиентов" as UC_ViewClients
    usecase "Редактировать данные клиента" as UC_EditClient
    usecase "Вести историю взаимодействий" as UC_ClientHistory
    
    ' ============================================
    ' Варианты использования - Управление заказами (Менеджер)
    ' ============================================
    usecase "Создать заказ" as UC_CreateOrder
    usecase "Просматривать заказы" as UC_ViewOrders
    usecase "Изменить статус заказа" as UC_UpdateOrderStatus
    usecase "Отменить заказ" as UC_CancelOrder
    usecase "Рассчитать стоимость заказа" as UC_CalculateOrderPrice
    
    ' ============================================
    ' Варианты использования - Управление сборкой (Сборщик/Менеджер)
    ' ============================================
    usecase "Создать сборочное задание" as UC_CreateAssemblyTask
    usecase "Назначить сборщика" as UC_AssignAssembler
    usecase "Начать сборку" as UC_StartAssembly
    usecase "Завершить сборку" as UC_CompleteAssembly
    usecase "Просматривать сборочные задания" as UC_ViewAssemblyTasks
    
    ' ============================================
    ' Варианты использования - Управление компонентами (Менеджер)
    ' ============================================
    usecase "Добавить компонент" as UC_AddComponent
    usecase "Редактировать компонент" as UC_EditComponent
    usecase "Удалить компонент" as UC_DeleteComponent
    usecase "Просматривать компоненты" as UC_ViewComponents
    
    ' ============================================
    ' Варианты использования - Управление складом (Менеджер)
    ' ============================================
    usecase "Просматривать остатки" as UC_ViewInventory
    usecase "Обновить остатки" as UC_UpdateInventory
    usecase "Провести инвентаризацию" as UC_InventoryCheck
    usecase "Переместить между складами" as UC_TransferBetweenWarehouses
    
    ' ============================================
    ' Варианты использования - Отчётность (Менеджер/Администратор)
    ' ============================================
    usecase "Сформировать отчёт по продажам" as UC_SalesReport
    usecase "Сформировать отчёт по сборкам" as UC_AssemblyReport
    usecase "Просмотреть аудит изменений" as UC_ViewAuditLog
    
    ' ============================================
    ' Варианты использования - Клиент (веб-приложение)
    ' ============================================
    usecase "Зарегистрироваться" as UC_ClientRegister
    usecase "Просматривать каталог компонентов" as UC_ViewCatalog
    usecase "Создать конфигурацию ПК" as UC_CreatePCConfig
    usecase "Оформить заказ" as UC_PlaceOrder
    usecase "Отслеживать статус заказа" as UC_TrackOrder
    usecase "Просматривать историю заказов" as UC_OrderHistory
}

' ============================================
' Связи актеров с вариантами использования
' ============================================

' Администратор
Admin --> UC_Login
Admin --> UC_Logout
Admin --> UC_ManageUsers
Admin --> UC_AssignRoles
Admin --> UC_BlockUser
Admin --> UC_ViewAuditLog

' Менеджер
Manager --> UC_Login
Manager --> UC_Logout
Manager --> UC_RegisterClient
Manager --> UC_ViewClients
Manager --> UC_EditClient
Manager --> UC_ClientHistory
Manager --> UC_CreateOrder
Manager --> UC_ViewOrders
Manager --> UC_UpdateOrderStatus
Manager --> UC_CancelOrder
Manager --> UC_CalculateOrderPrice
Manager --> UC_CreateAssemblyTask
Manager --> UC_AssignAssembler
Manager --> UC_ViewAssemblyTasks
Manager --> UC_AddComponent
Manager --> UC_EditComponent
Manager --> UC_DeleteComponent
Manager --> UC_ViewComponents
Manager --> UC_ViewInventory
Manager --> UC_UpdateInventory
Manager --> UC_InventoryCheck
Manager --> UC_TransferBetweenWarehouses
Manager --> UC_SalesReport
Manager --> UC_AssemblyReport

' Сборщик
Assembler --> UC_Login
Assembler --> UC_Logout
Assembler --> UC_ViewAssemblyTasks
Assembler --> UC_StartAssembly
Assembler --> UC_CompleteAssembly

' Клиент
Customer --> UC_ClientRegister
Customer --> UC_Login
Customer --> UC_RecoverPassword
Customer --> UC_ViewCatalog
Customer --> UC_CreatePCConfig
Customer --> UC_PlaceOrder
Customer --> UC_TrackOrder
Customer --> UC_OrderHistory

' ============================================
' Включения и расширения
' ============================================

UC_ManageUsers ..> UC_BlockUser : <<include>>
UC_CreateOrder ..> UC_CalculateOrderPrice : <<include>>
UC_CreateOrder ..> UC_RegisterClient : <<extend>>
UC_PlaceOrder ..> UC_CreatePCConfig : <<include>>
UC_TrackOrder ..> UC_ViewOrders : <<include>>
UC_StartAssembly ..> UC_ViewAssemblyTasks : <<include>>
UC_CompleteAssembly ..> UC_UpdateOrderStatus : <<include>>

@enduml
